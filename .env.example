# Copy this file to .env for local reference only - Django does NOT
# read .env automatically in this project. In production (Vercel),
# set these as real Environment Variables in the Vercel dashboard
# instead (Project -> Settings -> Environment Variables).

# Required in production
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://yourdomain.com

# Postgres connection string (from Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
