{% load static %}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ request.scheme }}://{{ request.get_host }}{% url 'coaching:home' %}</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  {% for plan in plans %}
  <url>
    <loc>{{ request.scheme }}://{{ request.get_host }}{% url 'coaching:checkout' plan.slug %}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  <url>
    <loc>{{ request.scheme }}://{{ request.get_host }}{% url 'coaching:contact' %}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ request.scheme }}://{{ request.get_host }}{% url 'coaching:privacy_policy' %}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ request.scheme }}://{{ request.get_host }}{% url 'coaching:refund_policy' %}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ request.scheme }}://{{ request.get_host }}{% url 'coaching:terms' %}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
